\cf0\b0\fs28 <?php\par
session_start();\par
\par
// If logout requested, destroy session and redirect to login\par
if (isset($_GET['action']) && $_GET['action'] === 'logout') \{\par
    $_SESSION = array();\par
    if (ini_get('session.use_cookies')) \{\par
        $params = session_get_cookie_params();\par
        setcookie(session_name(), '', time() - 42000,\par
            $params['path'], $params['domain'], $params['secure'], $params['httponly']\par
        );\par
    \}\par
    session_destroy();\par
    header('Location: session_auth.php');\par
    exit;\par
\}\par
\par
// If already logged in, show protected home\par
if (isset($_SESSION['user'])) \{\par
    $user = $_SESSION['user'];\par
