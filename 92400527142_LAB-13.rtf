\cf0\b0\fs28 <?php\par
// Simple visitor cookie: new vs returning\par
if (isset($_COOKIE['visitor'])) \{\par
    $count = (int)$_COOKIE['visitor'] + 1;\par
    setcookie('visitor', $count, time() + 30*24*3600, '/');\par
    $message = 'Welcome back! This is your visit number ' . $count . '.';\par
\} else \{\par
    setcookie('visitor', 1, time() + 30*24*3600, '/');\par
    $message = 'Welcome, new visitor!';\par
\}\par
?>\par
<!DOCTYPE html>\par
<html>\par
