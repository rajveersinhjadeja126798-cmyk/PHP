\cf0\b0\fs28 <?php\par
// Simple registration form + insert into `users` table.\par
// Update DB credentials below before using.\par
$DB_HOST = 'localhost';\par
$DB_USER = 'root';\par
$DB_PASS = '';\par
$DB_NAME = 'test';\par
\par
$mysqli = new mysqli($DB_HOST, $DB_USER, $DB_PASS, $DB_NAME);\par
if ($mysqli->connect_error) \{\par
    die('DB connection error: ' . $mysqli->connect_error);\par
\}\par
\par
if ($_SERVER['REQUEST_METHOD'] === 'POST') \{\par
    $name = trim($_POST['name'] ?? '');\par
    $email = trim($_POST['email'] ?? '');\par
    $username = trim($_POST['username'] ?? '');\par
    $password = $_POST['password'] ?? '';\par
\par
    if ($name === '' || $email === '' || $username === '' || $password === '') \{\par
        $error = 'Please fill all fields.';\par
    \} else \{\par
        $hash = password_hash($password, PASSWORD_DEFAULT);\par
        $stmt = $mysqli->prepare('INSERT INTO users (name, email, username, password) VALUES (?, ?, ?, ?)');\par
        if ($stmt) \{\par
            $stmt->bind_param('ssss', $name, $email, $username, $hash);\par
            if ($stmt->execute()) \{\par
                $success = 'Registration successful. You can now login.';\par
            \} else \{\par
                $error = 'Insert failed: ' . htmlspecialchars($stmt->error);\par
            \}\par
            $stmt->close();\par
        \} else \{\par
            $error = 'Prepare failed: ' . htmlspecialchars($mysqli->error);\par
        \}\par
    \}\par
\}\par
$mysqli->close();\par
?>\par
<!DOCTYPE html>\par
<html>\par
<head>\par
    <meta charset="UTF-8">\par
    <title>Register (DB)</title>\par
</head>\par
<body>\par
    <h1>Registration</h1>\par
    <?php if (!empty($error)): ?>\par
        <p style="color:red"><?php echo $error; ?></p>\par
    <?php endif; ?>\par
    <?php if (!empty($success)): ?>\par
        <p style="color:green"><?php echo $success; ?></p>\par
    <?php endif; ?>\par
    <form method="post" action="register_db.php">\par
        <label>Name: <input type="text" name="name" required></label><br><br>\par
        <label>Email: <input type="email" name="email" required></label><br><br>\par
        <label>Username: <input type="text" name="username" required></label><br><br>\par
        <label>Password: <input type="password" name="password" required></label><br><br>\par
        <button type="submit">Register</button>\par
    </form>\par
    <p>Note: Create table `users` before using. Example SQL:</p>\par
    <pre>CREATE TABLE users (id INT AUTO_INCREMENT PRIMARY KEY, name VARCHAR(100), email VARCHAR(100), username VARCHAR(50) UNIQUE, password VARCHAR(255));</pre>\par
</body>\par
</html>\par
